{
  "name": "isowasm",
  "version": "0.1.0",
  "private": true,
  "description": "Create ISO 9660 images in the browser with WebAssembly, powered by hadris-iso",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "test": "node --test tests/*.test.mjs",
    "test:quick": "ISOWASM_SKIP_LARGE=1 node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8765 --directory demo"
  },
  "engines": { "node": ">=20" }
}
